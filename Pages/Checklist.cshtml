@page
@model ChecklistModel
@{
    ViewData["Title"] = "Checklist";
    var s = Model.Submission!;
    var deptName = s.Area?.Department?.Name ?? "";
    var areaName = s.Area?.Name ?? "";
    var shiftName = s.Shift?.Name ?? "";
    var pdfName = $"SHEF014_{s.ChecklistDate:yyyyMMdd}_{areaName.Replace(' ', '_')}_{shiftName.Replace(' ', '_')}.pdf";
    string HourLabel(string label) => label.StartsWith("Hour ") ? label.Substring(5) : label;
}

<div class="audit-wrap" data-audit-form data-sub-id="@s.Id">
    <div class="audit-sticky">
        <div class="audit-sticky-top">
            <div>
                <div class="audit-sticky-title">@areaName — @shiftName</div>
                <div class="audit-sticky-sub">@deptName · @s.ChecklistDate.ToString("ddd dd MMM yyyy")
                    @if (s.CompletedAt.HasValue) { <span class="audit-badge-editing" style="background:#dcfce7;color:#16a34a;border-color:#86efac">Completed</span> }
                </div>
            </div>
        </div>
    </div>

    <div id="shift-progress-bar" style="background:var(--white);border:1px solid var(--border);border-radius:10px;padding:12px 16px;margin-bottom:14px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
            <span style="font-size:12px;font-weight:700">Progress</span>
            <span id="shift-progress-text" style="font-size:12px;color:var(--muted)">@Model.AnsweredCount of @Model.TotalCount</span>
        </div>
        <div style="height:8px;background:#e5e7eb;border-radius:4px;overflow:hidden">
            <div id="shift-progress-fill" style="height:100%;width:0;background:#16a34a;transition:width .2s"></div>
        </div>
    </div>

    <div class="summary-grid" style="grid-template-columns:1fr 1fr">
        <h3>Checklist details</h3>
        <div class="sfield">
            <label for="AuditorNames">Auditor name(s)</label>
            <textarea id="AuditorNames" data-header="auditorNames" rows="1"
                      style="min-height:44px" placeholder="Names of everyone on this checklist">@s.AuditorNames</textarea>
        </div>
        <div class="sfield">
            <label for="Location">Location</label>
            <textarea id="Location" data-header="location" rows="1"
                      style="min-height:44px" placeholder="e.g. DP1 &amp; DP3">@s.Location</textarea>
        </div>
    </div>

    @if (Model.NeedsHodSignOff)
    {
        <div class="summary-grid" style="grid-template-columns:1fr" id="hod-signoff-card">
            <h3>HOD sign-off</h3>
            <div class="sfield">
                <label>HOD who reviewed and signed off this checklist</label>
                <div class="fs" id="hod-picker" data-placeholder="Not yet signed off">
                    <button type="button" class="fs-trigger" aria-haspopup="listbox" aria-expanded="false" style="width:100%">
                        <svg class="fs-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>
                        </svg>
                        <span class="fs-display @(string.IsNullOrEmpty(s.HodSignOffName) ? "fs-placeholder" : "")">@(string.IsNullOrEmpty(s.HodSignOffName) ? "Not yet signed off" : s.HodSignOffName)</span>
                        <svg class="fs-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <input type="hidden" class="fs-input" value="@s.HodSignOffName">
                    <div class="fs-popover fs-popover-scroll" aria-hidden="true" role="listbox">
                        <div class="fs-search-wrap">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                            <input type="text" class="fs-search" placeholder="Search names…" autocomplete="off">
                        </div>
                        <div class="fs-group">
                            <button type="button" class="fs-option" data-value="" data-search="">
                                <span class="fs-option-label" style="color:var(--muted)">— Not yet signed off —</span>
                            </button>
                            @foreach (var p in Model.HodRoster)
                            {
                                <button type="button" class="fs-option @(s.HodSignOffName == p.Name ? "active" : "")" data-value="@p.Name" data-search="@p.Name.ToLowerInvariant()">
                                    <span class="fs-option-label">@p.Name</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="q-hint" id="hod-signoff-status">
                    @if (s.HodSignOffAt.HasValue) { <text>Signed off @s.HodSignOffAt.Value.ToLocalTime().ToString("dd MMM HH:mm")</text> }
                </div>
            </div>
        </div>
    }

    <form id="checklist-form" onsubmit="return false">
        @if (Model.TotalCount == 0)
        {
            <div class="card"><div class="empty">This shift has no task lines configured yet. Ask an admin to add them.</div></div>
        }

        @if (Model.GridSections.Any())
        {
            <div class="grid-wrap">
                <table>
                    <thead>
                        <tr>
                            <th class="qcol">Question</th>
                            @foreach (var cp in Model.GridCheckpoints)
                            {
                                <th class="hcol">Hr <span class="hnum">@HourLabel(cp.Label)</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var section in Model.GridSections)
                        {
                            <tr class="sec-row @ChecklistModel.SectionClass(section.Category)">
                                <td class="acc"></td><td colspan="@Model.GridCheckpoints.Count">@(section.Category)</td>
                            </tr>
                            @foreach (var item in section.Items)
                            {
                                Model.ResponsesByItem.TryGetValue(item.Id, out var r);
                                var anyIssue = r?.CheckpointResponses.Any(c => c.Status == SupportAuditSystem.Models.TaskStatus.Issue) ?? false;
                                <tr class="dr" data-grid-row data-item-id="@item.Id">
                                    <td class="ql">
                                        @item.Text
                                        @if (!string.IsNullOrEmpty(item.ResponsibleRole))
                                        {
                                            <div class="q-hint">Checked by @item.ResponsibleRole@(!string.IsNullOrEmpty(item.EscalateToRole)
                                                ? $" — escalate to {item.EscalateToRole} {item.EscalationWindow} if not resolved"
                                                : !string.IsNullOrEmpty(item.EscalationWindow) ? $" — resolve {item.EscalationWindow}" : "")</div>
                                        }
                                    </td>
                                    @foreach (var cp in item.Checkpoints.OrderBy(c => c.SortOrder))
                                    {
                                        var cr = r?.CheckpointResponses.FirstOrDefault(x => x.TaskCheckpointId == cp.Id);
                                        <td class="cell">
                                            <div class="yn-group">
                                                <input type="radio" class="yn-y" name="gy-@cp.Id" id="gy-@(cp.Id)-y" value="Done" data-cp-id="@cr?.Id" @(cr?.Status == "Done" ? "checked" : "")>
                                                <label for="gy-@(cp.Id)-y">Y</label>
                                                <input type="radio" class="yn-n" name="gy-@cp.Id" id="gy-@(cp.Id)-n" value="Issue" data-cp-id="@cr?.Id" @(cr?.Status == "Issue" ? "checked" : "")>
                                                <label for="gy-@(cp.Id)-n">N</label>
                                            </div>
                                        </td>
                                    }
                                </tr>
                                <tr class="nr" data-grid-note-row data-item-id="@item.Id" @(anyIssue ? "" : "hidden")>
                                    <td class="ql" style="font-style:normal">Notes (required — an hour was marked N)</td>
                                    <td class="nc" colspan="@Model.GridCheckpoints.Count">
                                        <textarea class="audit-ta" data-grid-note-for="@item.Id" style="width:100%;height:44px" placeholder="Describe the issue">@r?.Notes</textarea>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        @foreach (var item in Model.CardItems)
        {
            Model.ResponsesByItem.TryGetValue(item.Id, out var r);
            var status = r?.Status;
            var hasIssue = status == SupportAuditSystem.Models.TaskStatus.Issue;
            <div class="audit-card" data-task-card data-item-id="@item.Id">
                <div class="audit-q">
                    <div class="audit-q-label">
                        @if (!string.IsNullOrEmpty(item.Category) || !string.IsNullOrEmpty(item.Cadence))
                        {
                            <div class="item-tags">
                                @if (!string.IsNullOrEmpty(item.Category)) { <span class="item-tag">@item.Category</span> }
                                @if (!string.IsNullOrEmpty(item.Cadence)) { <span class="item-tag item-tag-muted">@item.Cadence</span> }
                            </div>
                        }
                        <span>@item.Text</span>
                        @if (!string.IsNullOrEmpty(item.ResponsibleRole))
                        {
                            <span class="q-hint">Checked by @item.ResponsibleRole@(!string.IsNullOrEmpty(item.EscalateToRole)
                                ? $" — escalate to {item.EscalateToRole} {item.EscalationWindow} if not resolved"
                                : !string.IsNullOrEmpty(item.EscalationWindow) ? $" — resolve {item.EscalationWindow}" : "")</span>
                        }
                        @if (item.IsTimeBoxed)
                        {
                            <span class="q-hint">Tick each checkpoint as it's genuinely done — the time is recorded.</span>
                        }
                    </div>
                    @if (!item.IsTimeBoxed)
                    {
                        <div class="audit-yn" role="group" aria-label="Response">
                            <input class="ayn-y" type="radio" name="st-@item.Id" id="done-@item.Id"
                                   value="Done" @(status == "Done" ? "checked" : "")>
                            <label for="done-@item.Id">Done</label>
                            <input class="ayn-n" type="radio" name="st-@item.Id" id="issue-@item.Id"
                                   value="Issue" @(hasIssue ? "checked" : "")>
                            <label for="issue-@item.Id">Issue</label>
                        </div>
                    }
                </div>

                @if (item.IsTimeBoxed)
                {
                    <div class="chk-checkpoints">
                        @foreach (var cp in item.Checkpoints.OrderBy(c => c.SortOrder))
                        {
                            var cr = r?.CheckpointResponses.FirstOrDefault(x => x.TaskCheckpointId == cp.Id);
                            <button type="button" class="chk-cp @(cr?.Ticked == true ? "ticked" : "")"
                                    data-cp-id="@cr?.Id" aria-pressed="@(cr?.Ticked == true ? "true" : "false")">
                                <span class="chk-cp-label">@cp.Label</span>
                                <span class="chk-cp-time">@(cr?.Ticked == true && cr.TickedAt != null ? cr.TickedAt.Value.ToLocalTime().ToString("HH:mm") : "")</span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="audit-note" data-note-block @(hasIssue ? "" : "hidden")>
                        <label class="audit-note-lbl" for="note-@item.Id">Note (required for an issue)</label>
                        <textarea class="audit-ta" id="note-@item.Id" data-note-for="@item.Id"
                                  placeholder="Describe the issue">@r?.Notes</textarea>
                    </div>
                }
            </div>
        }
    </form>

    @if (Model.TotalCount > 0)
    {
        <div class="audit-footer">
            <a class="sbtn" asp-page="/Index">Leave &amp; come back later</a>
            <a class="sbtn" href="/api/checklist/@s.Id/pdf" data-filename="@pdfName">Download PDF</a>
            <button type="button" class="welcome-btn primary" id="complete-btn" style="margin:0">Complete checklist</button>
        </div>
        <div id="complete-msg" class="err" style="text-align:center;margin-top:10px" hidden></div>
    }
</div>

@section Scripts {
<style>
    .chk-checkpoints { display:flex; flex-wrap:wrap; gap:10px; padding:14px 18px; border-top:1px solid var(--border); }
    .chk-cp {
        display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;
        min-width:72px; min-height:48px; padding:8px 14px; border:1px solid var(--border);
        border-radius:12px; background:var(--white); font-family:inherit; cursor:pointer; color:var(--muted);
        transition:background var(--dur-fast) var(--ease-ios), color var(--dur-fast) var(--ease-ios), border-color var(--dur-fast) var(--ease-ios), transform var(--dur-fast) var(--ease-spring);
    }
    .chk-cp:active { opacity:.85; }
    .chk-cp-label { font-size:13px; font-weight:700; }
    .chk-cp-time { font-size:11px; font-weight:600; min-height:13px; }
    .chk-cp.ticked { background:var(--green-bg); color:var(--green); border-color:#86efac; }
    .chk-saving { opacity:.55; }
    .save-flash { animation:checkPop .4s var(--ease-spring); }
    .item-tags { display:flex; gap:6px; margin-bottom:4px; flex-wrap:wrap; }
    .item-tag {
        display:inline-block; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.04em;
        padding:2px 8px; border-radius:99px; background:var(--accent-soft); color:var(--accent);
    }
    .item-tag-muted { background:var(--surface); color:var(--muted); border:1px solid var(--border); }
    .yn-group.gy-saving { opacity:.55; }
</style>
<script>
(function () {
    var wrap = document.querySelector('[data-audit-form]');
    if (!wrap) return;
    var subId = wrap.getAttribute('data-sub-id');

    function csrf() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    function post(url, body) {
        return fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrf() },
            body: JSON.stringify(body)
        }).then(function (res) {
            return res.json().catch(function () { return { ok: res.ok }; })
                .then(function (data) { return { ok: res.ok && data.ok !== false, data: data }; });
        });
    }

    function flash(el, ok) {
        if (!el) return;
        el.classList.remove('chk-saving');
        if (ok) { el.classList.add('save-flash'); setTimeout(function(){ el.classList.remove('save-flash'); }, 400); }
    }

    // Done / Issue radios (single-column cards) — save immediately, toggle the note block.
    wrap.querySelectorAll('[data-task-card]').forEach(function (card) {
        var itemId = card.getAttribute('data-item-id');
        var radios = card.querySelectorAll('.audit-yn input[type="radio"]');
        var noteBlock = card.querySelector('[data-note-block]');
        var noteTa = card.querySelector('[data-note-for]');

        radios.forEach(function (radio) {
            radio.addEventListener('change', function () {
                var status = radio.value;
                if (noteBlock) noteBlock.hidden = (status !== 'Issue');
                card.classList.add('chk-saving');
                post('/api/checklist/' + subId + '/response', {
                    taskItemId: parseInt(itemId, 10),
                    status: status,
                    notes: noteTa ? noteTa.value : null
                }).then(function (r) {
                    card.classList.remove('chk-saving');
                    flash(card.querySelector('.audit-yn'), r.ok);
                    if (!r.ok) alert((r.data && r.data.error) || 'Could not save — try again.');
                });
            });
        });

        if (noteTa) {
            var t;
            noteTa.addEventListener('input', function () {
                clearTimeout(t);
                t = setTimeout(function () {
                    var checked = card.querySelector('.audit-yn input:checked');
                    post('/api/checklist/' + subId + '/response', {
                        taskItemId: parseInt(itemId, 10),
                        status: checked ? checked.value : null,
                        notes: noteTa.value
                    });
                }, 500);
            });
        }
    });

    // Checkpoints (Stores-style simple tick strip) — toggle + save with a timestamp.
    wrap.querySelectorAll('.chk-cp').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var cpId = btn.getAttribute('data-cp-id');
            var ticked = !btn.classList.contains('ticked');
            btn.classList.add('chk-saving');
            post('/api/checklist/' + subId + '/checkpoint', {
                checkpointResponseId: parseInt(cpId, 10),
                ticked: ticked
            }).then(function (r) {
                btn.classList.remove('chk-saving');
                if (!r.ok) { alert((r.data && r.data.error) || 'Could not save — try again.'); return; }
                btn.classList.toggle('ticked', ticked);
                btn.setAttribute('aria-pressed', ticked ? 'true' : 'false');
                var time = btn.querySelector('.chk-cp-time');
                if (time) time.textContent = ticked ? (r.data.tickedAt || '') : '';
                flash(btn, true);
            });
        });
    });

    // Grid (hourly Y/N) rows — each cell saves its own Done/Issue answer; the
    // row's note area reveals once any hour in that row is marked N.
    function gridRowHasIssue(row) {
        return !!row.querySelector('.yn-n:checked');
    }
    function updateGridNoteVisibility(row) {
        var itemId = row.getAttribute('data-item-id');
        var noteRow = wrap.querySelector('[data-grid-note-row][data-item-id="' + itemId + '"]');
        if (noteRow) noteRow.hidden = !gridRowHasIssue(row);
    }
    wrap.querySelectorAll('[data-grid-row]').forEach(function (row) {
        row.querySelectorAll('.yn-y, .yn-n').forEach(function (radio) {
            radio.addEventListener('change', function () {
                var cpId = radio.getAttribute('data-cp-id');
                var group = radio.closest('.yn-group');
                if (group) group.classList.add('gy-saving');
                post('/api/checklist/' + subId + '/checkpoint-status', {
                    checkpointResponseId: parseInt(cpId, 10),
                    status: radio.value
                }).then(function (r) {
                    if (group) group.classList.remove('gy-saving');
                    if (!r.ok) { alert((r.data && r.data.error) || 'Could not save — try again.'); return; }
                    updateGridNoteVisibility(row);
                    flash(group, true);
                });
            });
        });
    });
    wrap.querySelectorAll('[data-grid-note-for]').forEach(function (ta) {
        var itemId = ta.getAttribute('data-grid-note-for');
        var t;
        ta.addEventListener('input', function () {
            clearTimeout(t);
            t = setTimeout(function () {
                post('/api/checklist/' + subId + '/response', {
                    taskItemId: parseInt(itemId, 10),
                    status: null,
                    notes: ta.value
                });
            }, 500);
        });
    });

    // Header fields (auditor names, location) — save on blur.
    wrap.querySelectorAll('[data-header]').forEach(function (ta) {
        ta.addEventListener('blur', function () {
            var names = wrap.querySelector('[data-header="auditorNames"]');
            var loc = wrap.querySelector('[data-header="location"]');
            post('/api/checklist/' + subId + '/header', {
                auditorNames: names ? names.value : null,
                location: loc ? loc.value : null
            });
        });
    });

    // HOD sign-off — saves immediately when a name is picked (site.js's
    // initFilter already wires the .fs popover/search; we just listen for the
    // resulting value change on its hidden input).
    var hodPicker = document.getElementById('hod-picker');
    if (hodPicker) {
        var hodStatus = document.getElementById('hod-signoff-status');
        hodPicker.querySelectorAll('.fs-option').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var name = btn.getAttribute('data-value') || null;
                post('/api/checklist/' + subId + '/hodsignoff', { hodName: name }).then(function (r) {
                    if (!r.ok) { alert((r.data && r.data.error) || 'Could not save — try again.'); return; }
                    if (hodStatus) hodStatus.textContent = name ? ('Signed off ' + r.data.signedAt) : '';
                });
            });
        });
    }

    // Progress indicator — cards and grid rows each count as one unit, done
    // once a response exists (a status set, a checkpoint ticked, or any
    // hour in a grid row answered).
    function updateProgress() {
        var units = wrap.querySelectorAll('[data-task-card], [data-grid-row]');
        var done = 0;
        units.forEach(function (unit) {
            var checked = unit.querySelector('.audit-yn input:checked, .yn-y:checked, .yn-n:checked');
            var anyCp = unit.querySelector('.chk-cp.ticked');
            if (checked || anyCp) done++;
        });
        var fill = document.getElementById('shift-progress-fill');
        var text = document.getElementById('shift-progress-text');
        var total = units.length;
        var pct = total ? Math.round((done / total) * 100) : 0;
        if (fill) fill.style.width = pct + '%';
        if (text) text.textContent = done + ' of ' + total;
    }
    wrap.addEventListener('change', updateProgress);
    wrap.addEventListener('click', function (e) {
        if (e.target.closest('.chk-cp')) setTimeout(updateProgress, 50);
    });
    updateProgress();

    // Complete — server validates every issue has a note.
    var completeBtn = document.getElementById('complete-btn');
    var msg = document.getElementById('complete-msg');
    if (completeBtn) {
        completeBtn.addEventListener('click', function () {
            completeBtn.disabled = true;
            if (msg) msg.hidden = true;
            post('/api/checklist/' + subId + '/complete', {}).then(function (r) {
                if (r.ok) {
                    window.location = '/Success?id=' + subId;
                    return;
                }
                completeBtn.disabled = false;
                if (msg) {
                    var miss = (r.data && r.data.missingNotes) || [];
                    msg.hidden = false;
                    msg.textContent = miss.length
                        ? 'Add a note to each issue before completing: ' + miss.length + ' outstanding.'
                        : ((r.data && r.data.error) || 'Could not complete — try again.');
                    // Highlight missing notes on single-column cards.
                    wrap.querySelectorAll('[data-task-card]').forEach(function (card) {
                        var issue = card.querySelector('.ayn-n:checked');
                        var note = card.querySelector('[data-note-for]');
                        var block = card.querySelector('[data-note-block]');
                        if (issue && note && !note.value.trim()) {
                            if (block) block.classList.add('hour-incomplete');
                        } else if (block) {
                            block.classList.remove('hour-incomplete');
                        }
                    });
                    // Highlight missing notes on grid rows.
                    wrap.querySelectorAll('[data-grid-row]').forEach(function (row) {
                        var itemId = row.getAttribute('data-item-id');
                        var noteRow = wrap.querySelector('[data-grid-note-row][data-item-id="' + itemId + '"]');
                        var ta = noteRow ? noteRow.querySelector('[data-grid-note-for]') : null;
                        if (gridRowHasIssue(row) && ta && !ta.value.trim()) {
                            if (noteRow) { noteRow.hidden = false; noteRow.classList.add('hour-incomplete'); }
                        } else if (noteRow) {
                            noteRow.classList.remove('hour-incomplete');
                        }
                    });
                }
            });
        });
    }
})();
</script>
<form style="display:none">@Html.AntiForgeryToken()</form>
}
